<?xml version="1.0"?>
<sdf version="1.9">
  <model name="my_robot">
    <self_collide>false</self_collide>

    <!-- Main chassis -->
    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.032</ixx>
          <iyy>0.048</iyy>
          <izz>0.070</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.4 0.3 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.4 0.3 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.5 0.8 1</ambient>
          <diffuse>0.2 0.5 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Left drive wheel -->
    <link name="left_wheel">
      <pose>0.05 0.18 -0.05 1.5707963 0 0</pose>

      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00075</ixx>
          <iyy>0.00075</iyy>
          <izz>0.0015</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Right drive wheel -->
    <link name="right_wheel">
      <pose>0.05 -0.18 -0.05 1.5707963 0 0</pose>

      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00075</ixx>
          <iyy>0.00075</iyy>
          <izz>0.0015</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Passive rear caster -->
    <link name="caster_wheel">
      <pose>-0.14 0 -0.075 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00018</ixx>
          <iyy>0.00018</iyy>
          <izz>0.00018</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_wheel</child>
    </joint>

    <!-- LiDAR link and sensor -->
    <link name="lidar_link">
        <pose>0 0 0.08 0 0 0</pose>

        <inertial>
            <mass>0.01</mass>
            <inertia>
            <ixx>0.00001</ixx>
            <iyy>0.00001</iyy>
            <izz>0.00001</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
            </inertia>
        </inertial>

        <visual name="lidar_visual">
            <geometry>
            <cylinder>
                <radius>0.04</radius>
                <length>0.04</length>
            </cylinder>
            </geometry>
        </visual>

        <sensor name="lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>/scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>

            <lidar>
            <scan>
                <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
                </horizontal>
                <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
                </vertical>
            </scan>

            <range>
                <min>0.12</min>
                <max>8.0</max>
                <resolution>0.01</resolution>
            </range>
            </lidar>
        </sensor>
    </link>

    <!-- Attach LiDAR to the chassis -->
    <joint name="lidar_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
    </joint>

    <link name="camera_link">
        <pose>0.20 0 0.10 0 0 0</pose>

        <inertial>
            <mass>0.05</mass>
            <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
            </inertia>
        </inertial>

        <visual name="camera_visual">
            <geometry>
            <box>
                <size>0.05 0.05 0.04</size>
            </box>
            </geometry>
        </visual>

        <sensor name="camera_sensor" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>/camera/image_raw</topic>
            <camera_info_topic>/camera/camera_info</camera_info_topic>
            <gz_frame_id>camera_link</gz_frame_id>

            <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
                <width>640</width>
                <height>480</height>
                <format>L8</format>
            </image>
            <clip>
                <near>0.1</near>
                <far>20.0</far>
            </clip>
            </camera>
        </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent>base_link</parent>
        <child>camera_link</child>
    </joint>

    <link name="forklift_carriage">
      <!-- Initial position; the joint moves this link vertically -->
      <pose>0.19 0 -0.2 0 0 0</pose>

      <inertial>
        <mass>.1</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Carriage plate -->
      <visual name="carriage_visual">
        <pose>0.0 0.0 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.3 0.05</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 0.1 0.05 1</diffuse>
        </material>
      </visual>

      <!-- Left fork: extends forward along +X -->
      <visual name="left_fork_visual">
        <pose>0.16 0.08 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.06 0.01</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 0.1 0.05 1</diffuse>
        </material>
      </visual>

      <collision name="left_fork_collision">
        <pose>0.16 0.08 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.06 0.01</size>
          </box>
        </geometry>
      </collision>

      <!-- Right fork -->
      <visual name="right_fork_visual">
        <pose>0.16 -0.08 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.06 0.01</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 0.1 0.05 1</diffuse>
        </material>
      </visual>

      <collision name="right_fork_collision">
        <pose>0.16 -0.08 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.06 0.01</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="forklift_lift_joint" type="prismatic">
      <parent>base_link</parent>
      <child>forklift_carriage</child>

      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0.1</lower>
          <upper>0.15</upper>
          <effort>100</effort>
          <velocity>0.2</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Gazebo differential drive -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.075</wheel_radius>

        <!-- Acceleration limits -->
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>5.0</max_angular_acceleration>
        <min_angular_acceleration>-5.0</min_angular_acceleration>

      <topic>/model/my_robot/cmd_vel</topic>
      <odom_topic>/model/my_robot/odometry</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <tf_topic>/model/my_robot/tf</tf_topic>

      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
    </plugin>

    <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

      <joint_name>forklift_lift_joint</joint_name>
      <topic>/forklift/lift/position_gz</topic>

      <p_gain>100</p_gain>
      <i_gain>0</i_gain>
      <d_gain>10</d_gain>

      <i_max>10</i_max>
      <i_min>-10</i_min>

      <cmd_max>100</cmd_max>
      <cmd_min>-100</cmd_min>
    </plugin>
  </model>
</sdf>