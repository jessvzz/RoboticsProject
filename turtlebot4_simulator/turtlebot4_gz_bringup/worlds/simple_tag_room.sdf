<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="simple_tag_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor: exactly 3 x 3 meters -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3 3 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3 3 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four walls: 3 x 3 m outer footprint, 2.5 m high -->
    <model name="room_walls">
      <static>true</static>

      <!-- North wall -->
      <link name="north_wall">
        <pose>0 1.45 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>3 0.1 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3 0.1 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.45 1</ambient>
            <diffuse>0.25 0.35 0.45 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South wall -->
      <link name="south_wall">
        <pose>0 -1.45 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>3 0.1 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3 0.1 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.45 1</ambient>
            <diffuse>0.25 0.35 0.45 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- East wall -->
      <link name="east_wall">
        <pose>1.45 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.1 3 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 3 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.45 1</ambient>
            <diffuse>0.25 0.35 0.45 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- West wall -->
      <link name="west_wall">
        <pose>-1.45 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.1 3 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 3 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.45 1</ambient>
            <diffuse>0.25 0.35 0.45 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!-- Colored floor zones beneath the AprilTags -->
    <model name="tag_carpet_north">
      <static>true</static>
      <pose>0 1.05 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.5 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.5 1</ambient>
            <diffuse>0.1 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tag_carpet_south">
      <static>true</static>
      <pose>0 -1.05 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.5 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.5 1</ambient>
            <diffuse>0.1 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tag_carpet_east">
      <static>true</static>
      <pose>1.05 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.8 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.5 1</ambient>
            <diffuse>0.1 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tag_carpet_west">
      <static>true</static>
      <pose>-1.05 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.8 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.5 1</ambient>
            <diffuse>0.1 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTags mounted on the inner faces of the walls -->

    <!-- North wall: face points toward the room (-Y) -->
    <include>
      <uri>model://Apriltag36_11_00002</uri>
      <pose>0 1.39 0.3 1.57079632679 0 0</pose>
    </include>

    <!-- South wall: face points toward the room (+Y) -->
    <include>
      <uri>model://Apriltag36_11_00007</uri>
      <pose>0 -1.39 0.3 -1.57079632679 0 0</pose>
    </include>

    <!-- East wall: face points toward the room (-X) -->
    <include>
      <uri>model://Apriltag36_11_00009</uri>
      <pose>1.39 0 0.3 1.57079632679 0 1.57079632679</pose>
    </include>

    <!-- West wall: face points toward the room (+X) -->
    <include>
      <uri>model://Apriltag36_11_00013</uri>
      <pose>-1.39 0 0.3 1.57079632679 0 -1.57079632679</pose>
    </include>

  </world>
</sdf>